
<div class="movies">
  <h1>{{title}}</h1> 
  <div class ="movie-grid">
    {{#each movies}}
      <article class="movie-card">
        <h2>{{attributes.title}}</h2>

        <p>{{attributes.description}}</p>
        <img src="{{attributes.image.url}}" alt="Affisch för {{attributes.title}}" />
        <a href="/movies/{{id}}">
          Läs mer
        </a>
      </article>
    {{/each}}
  </div>
</div>